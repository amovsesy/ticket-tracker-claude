# Database
# Note: This app uses Cloudflare D1 (SQLite), configured in wrangler.jsonc
# No DATABASE_URL needed for local development

# Cloudflare (only needed for production deployment)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_D1_TOKEN=your_d1_token

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxxxx
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Statsig Feature Flags
PUBLIC_STATSIG_SDK_KEY=client-xxxxx
STATSIG_SERVER_KEY=secret-xxxxx
PUBLIC_STATSIG_TIER=development

# Sentry Error Tracking
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Email Notifications (Resend)
RESEND_API_KEY=re_xxxxx

# SMS Notifications (Plivo)
PLIVO_AUTH_ID=your_auth_id
PLIVO_AUTH_TOKEN=your_auth_token
PLIVO_PHONE_NUMBER=+1234567890

# Browser Scraper Service
# For local testing: BROWSER_SCRAPER_URL=http://localhost:8080
# For production (GCP Cloud Run): BROWSER_SCRAPER_URL=https://browser-scraper-xxxxx-uc.a.run.app
# Leave empty to skip browser scraping (will fail on bot-protected sites like StubHub)
BROWSER_SCRAPER_URL=
