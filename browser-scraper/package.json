{
	"name": "browser-scraper",
	"version": "1.0.0",
	"description": "Headless browser scraper service for ticket price tracking",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "node index.js",
		"dev": "node --watch index.js",
		"test": "node test.js",
		"test:watch": "node --watch test.js",
		"deploy": "gcloud run deploy browser-scraper --source . --region us-central1 --memory 1Gi --timeout 30s --min-instances 0 --max-instances 5 --allow-unauthenticated"
	},
	"dependencies": {
		"express": "^4.18.2",
		"node-fetch": "^3.3.2",
		"puppeteer": "^21.11.0"
	},
	"engines": {
		"node": ">=18"
	}
}
